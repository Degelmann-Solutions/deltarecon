{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "localise.schema.json",
  "title": "Stage contracts version 3: walk result and search result",
  "properties": { "document": { "enum": ["walk_result", "search_result"] } },
  "if": { "properties": { "document": { "const": "walk_result" } } },
  "then": { "$ref": "#/$defs/walk_result" },
  "else": { "$ref": "#/$defs/search_result" },
  "$defs": {
    "state_number": {
      "description": "The number of a state: 0 is the older release, k the state after the k-th revision of the manifest.",
      "type": "integer",
      "minimum": 0
    },
    "side": {
      "description": "One of the two recorded results the walk starts from.",
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "release_label"],
      "properties": {
        "run_id": { "$ref": "common.schema.json#/$defs/id" },
        "release_label": { "$ref": "common.schema.json#/$defs/id" }
      }
    },
    "compare_reference": {
      "description": "A comparison the walk wrote: its compare result and, for the outcome compared, its deviation file.",
      "type": "object",
      "additionalProperties": false,
      "required": ["result"],
      "properties": {
        "result": { "$ref": "common.schema.json#/$defs/artifact" },
        "deviations": { "$ref": "common.schema.json#/$defs/artifact" }
      }
    },
    "end": {
      "description": "The check of one end of the walk against the recorded result of that end.",
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "outcome"],
      "properties": {
        "state": { "$ref": "#/$defs/state_number" },
        "outcome": { "enum": ["reproduced", "not_reproduced", "not_run"] },
        "compare": { "$ref": "#/$defs/compare_reference" }
      },
      "if": { "properties": { "outcome": { "const": "not_reproduced" } } },
      "then": { "required": ["compare"] },
      "else": { "not": { "required": ["compare"] } }
    },
    "state": {
      "description": "One state of the walk and the outcome of its run.",
      "allOf": [
        { "$ref": "#/$defs/search_state" },
        { "not": { "required": ["reused"] } }
      ]
    },
    "search_state": {
      "description": "One state of a walk or a search and the outcome of its run. A search under the switch reuse_walk marks a state it took from the walk with reused.",
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "run_id", "outcome", "response"],
      "properties": {
        "state": { "$ref": "#/$defs/state_number" },
        "revision": { "$ref": "common.schema.json#/$defs/id" },
        "run_id": { "$ref": "common.schema.json#/$defs/id" },
        "outcome": { "enum": ["succeeded", "failed", "error", "rejected"] },
        "reused": { "const": true },
        "response": { "$ref": "common.schema.json#/$defs/artifact" },
        "export": { "$ref": "common.schema.json#/$defs/artifact" }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "const": "succeeded" } } },
          "then": { "required": ["export"] },
          "else": { "not": { "required": ["export"] } }
        },
        {
          "if": { "properties": { "state": { "const": 0 } } },
          "then": { "not": { "required": ["revision"] } },
          "else": { "required": ["revision"] }
        }
      ]
    },
    "contribution": {
      "description": "What one step contributes to one quantity. A sum is absent when it is not a finite binary64 number.",
      "type": "object",
      "additionalProperties": false,
      "required": ["quantity", "contributes"],
      "properties": {
        "quantity": { "type": "string", "pattern": "^[^\\u0000-\\u001f]+$" },
        "contributes": { "type": "boolean" },
        "sum": { "type": "number" },
        "absolute_sum": { "type": "number", "minimum": 0 },
        "signature": { "$ref": "compare.schema.json#/$defs/signature_row" }
      }
    },
    "step": {
      "description": "The step from one state that ran to the next state that ran, and the revisions it carries.",
      "type": "object",
      "additionalProperties": false,
      "required": ["from_state", "to_state", "revisions", "contributions"],
      "properties": {
        "from_state": { "$ref": "#/$defs/state_number" },
        "to_state": { "$ref": "#/$defs/state_number" },
        "revisions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/id" }
        },
        "compare": { "$ref": "#/$defs/compare_reference" },
        "contributions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/contribution" }
        }
      },
      "if": { "properties": { "contributions": { "contains": { "properties": { "contributes": { "const": true } } } } } },
      "then": { "required": ["compare"] },
      "else": { "not": { "required": ["compare"] } }
    },
    "held": {
      "description": "A kind of release reference held at the older release for every state, and the revisions whose effect on it the walk does not show.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "classes", "not_shown"],
      "properties": {
        "kind": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "classes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "changes.schema.json#/$defs/change_class" }
        },
        "not_shown": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/id" }
        }
      }
    },
    "total": {
      "description": "The deviation of one quantity between the two recorded results: the sum of newer minus older over all coordinates.",
      "type": "object",
      "additionalProperties": false,
      "required": ["quantity"],
      "properties": {
        "quantity": { "type": "string", "pattern": "^[^\\u0000-\\u001f]+$" },
        "sum": { "type": "number" }
      }
    },
    "finding_members": {
      "description": "The members of a finding of a walk or a search.",
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "message": { "$ref": "common.schema.json#/$defs/text" },
        "state": { "$ref": "#/$defs/state_number" },
        "revisions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/id" }
        },
        "quantity": { "type": "string", "pattern": "^[^\\u0000-\\u001f]+$" },
        "diagnostic": { "$ref": "common.schema.json#/$defs/diagnostic" },
        "compare": { "$ref": "#/$defs/compare_reference" }
      }
    },
    "finding": {
      "description": "Something the walk found that a person must look at.",
      "allOf": [
        { "$ref": "#/$defs/finding_members" },
        {
          "properties": {
            "code": {
              "enum": ["state_zero_not_reproduced", "state_n_not_reproduced", "state_did_not_run",
                       "step_not_compared", "non_finite_difference"]
            }
          }
        }
      ]
    },
    "search_finding": {
      "description": "Something the search found that a person must look at.",
      "allOf": [
        { "$ref": "#/$defs/finding_members" },
        {
          "properties": {
            "code": {
              "enum": ["state_zero_not_reproduced", "state_n_not_reproduced", "state_did_not_run",
                       "step_not_compared", "non_finite_difference", "interval_not_resolved"]
            }
          }
        }
      ]
    },
    "quantity_name": { "type": "string", "pattern": "^[^\\u0000-\\u001f]+$" },
    "target": {
      "description": "The coordinates a search judges: quantities, and optionally an inclusive period range.",
      "type": "object",
      "additionalProperties": false,
      "required": ["quantities"],
      "properties": {
        "quantities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/quantity_name" }
        },
        "periods": {
          "type": "object",
          "additionalProperties": false,
          "required": ["first", "last"],
          "properties": {
            "first": { "type": "integer", "minimum": 0 },
            "last": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "interval": {
      "description": "An interval the search judged: its two end states, the revisions between them, and the target quantities for which they differ.",
      "type": "object",
      "additionalProperties": false,
      "required": ["from_state", "to_state", "revisions", "differs"],
      "properties": {
        "from_state": { "$ref": "#/$defs/state_number" },
        "to_state": { "$ref": "#/$defs/state_number" },
        "revisions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/id" }
        },
        "differs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/quantity_name" }
        }
      }
    },
    "search_contribution": {
      "description": "A contribution the search found: an interval in the shape of a step of the walk that contributes to at least one quantity, with its comparison.",
      "allOf": [
        { "$ref": "#/$defs/step" },
        {
          "required": ["compare"],
          "properties": {
            "contributions": { "contains": { "properties": { "contributes": { "const": true } } } }
          }
        }
      ]
    },
    "search_result": {
      "description": "The result of a search that halves the history between two recorded results for a target: the contributions it found, the intervals it judged, its runs, and, when checked against a walk, the contributions it missed.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document", "contract_version", "stage", "search_id", "manifest", "older", "newer", "tolerance",
        "held", "remainder", "ends", "states", "target", "intervals", "contributions", "runs", "findings"
      ],
      "dependentRequired": { "walk": ["missed"], "missed": ["walk"] },
      "if": { "required": ["switches"], "properties": { "switches": { "contains": { "const": "reuse_walk" } } } },
      "then": { "required": ["walk"], "properties": { "runs": { "required": ["reused"] } } },
      "else": {
        "properties": {
          "runs": { "properties": { "search": { "minimum": 1 } }, "not": { "required": ["reused"] } },
          "states": { "items": { "not": { "required": ["reused"] } } }
        }
      },
      "properties": {
        "document": { "const": "search_result" },
        "contract_version": { "$ref": "common.schema.json#/$defs/contract_version" },
        "stage": { "$ref": "common.schema.json#/$defs/stage" },
        "search_id": { "$ref": "common.schema.json#/$defs/id" },
        "switches": {
          "description": "The opt-in switches that were on for the search, by name; absent when none was on.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["reuse_walk"] }
        },
        "walk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["walk_id", "result"],
          "properties": {
            "walk_id": { "$ref": "common.schema.json#/$defs/id" },
            "result": { "$ref": "common.schema.json#/$defs/artifact" }
          }
        },
        "manifest": { "$ref": "common.schema.json#/$defs/artifact" },
        "older": { "$ref": "#/$defs/side" },
        "newer": { "$ref": "#/$defs/side" },
        "tolerance": { "$ref": "compare.schema.json#/$defs/tolerance" },
        "held": {
          "type": "array",
          "items": { "$ref": "#/$defs/held" }
        },
        "remainder": { "$ref": "changes.schema.json#/$defs/history/properties/remainder" },
        "ends": {
          "type": "object",
          "additionalProperties": false,
          "required": ["zero", "n"],
          "properties": {
            "zero": { "$ref": "#/$defs/end" },
            "n": { "$ref": "#/$defs/end" }
          }
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/search_state" }
        },
        "target": { "$ref": "#/$defs/target" },
        "intervals": {
          "type": "array",
          "items": { "$ref": "#/$defs/interval" }
        },
        "contributions": {
          "type": "array",
          "items": { "$ref": "#/$defs/search_contribution" }
        },
        "runs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["walk", "search", "saved"],
          "properties": {
            "walk": { "type": "integer", "minimum": 1 },
            "search": { "type": "integer", "minimum": 0 },
            "saved": { "type": "integer", "minimum": 0 },
            "reused": { "type": "integer", "minimum": 0 }
          }
        },
        "missed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["revision", "quantity"],
            "properties": {
              "revision": { "$ref": "common.schema.json#/$defs/id" },
              "quantity": { "$ref": "#/$defs/quantity_name" }
            }
          }
        },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/search_finding" }
        }
      }
    },
    "walk_result": {
      "description": "The result of a walk over every state between two recorded results: per revision and quantity the contribution of that revision.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document", "contract_version", "stage", "walk_id", "manifest", "older", "newer", "tolerance",
        "held", "remainder", "ends", "states", "steps", "unattributed", "totals", "findings"
      ],
      "properties": {
        "document": { "const": "walk_result" },
        "contract_version": { "$ref": "common.schema.json#/$defs/contract_version" },
        "stage": { "$ref": "common.schema.json#/$defs/stage" },
        "walk_id": { "$ref": "common.schema.json#/$defs/id" },
        "manifest": { "$ref": "common.schema.json#/$defs/artifact" },
        "older": { "$ref": "#/$defs/side" },
        "newer": { "$ref": "#/$defs/side" },
        "tolerance": { "$ref": "compare.schema.json#/$defs/tolerance" },
        "held": {
          "type": "array",
          "items": { "$ref": "#/$defs/held" }
        },
        "remainder": { "$ref": "changes.schema.json#/$defs/history/properties/remainder" },
        "ends": {
          "type": "object",
          "additionalProperties": false,
          "required": ["zero", "n"],
          "properties": {
            "zero": { "$ref": "#/$defs/end" },
            "n": { "$ref": "#/$defs/end" }
          }
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/state" }
        },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/step" }
        },
        "unattributed": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/id" }
        },
        "totals": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/total" }
        },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding" }
        }
      }
    }
  }
}
