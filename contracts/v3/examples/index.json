    {
      "id": "compare-result",
      "expected": "accept",
      "matrix_rows": [
        "coverage-difference",
        "tolerance-boundary",
        "parameter-diff"
      ],
      "rules": [
        "compare.md#alignment",
        "compare.md#coverage-differences",
        "compare.md#tolerance-rule",
        "compare.md#compare-result",
        "compare.md#deviation-file",
        "compare.md#parameter-diff"
      ],
      "shows": "Compares the full run with the subset run under a tolerance profile per quantity; quantities without an entry are compared exactly. MP-0001, period 0: Kosten 2. Ordnung ohne Provisionen 100 against 100.25 lies exactly on its upper bound of 0.25 and is no deviation; Netto-Cashflow 380 against 379.75 lies exactly on its lower bound; Bruttobeitrag 1200 against 1201 is covered by the relative bound; Beitragsverrechnung 400 against 401 has no entry and deviates. MP-0001, period 2: Anzahl Verträge 0.99 against 0.9905 has no entry and deviates. MP-0002, period 145: Provisionen 0.6972 against 0.6974 is rounded to two decimal places on both sides and is no deviation. MP-0002 period 146 is added, MP-0003 is removed, and neither is compared against zero. Every rounding and every bound above zero carries its derivation. The four deviating coordinates are the rows of compare.deviations.csv, which the result references with its byte hash. The parameter diff shows one added, one changed, and one removed parameter.",
      "documents": [
        {
          "path": "reference/compare.request.json",
          "schema": "compare.schema.json"
        },
        {
          "path": "reference/compare.result.json",
          "schema": "compare.schema.json"
        },
