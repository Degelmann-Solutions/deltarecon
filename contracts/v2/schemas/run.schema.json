{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run.schema.json",
  "title": "Stage contracts version 2: run request and run response",
  "oneOf": [
    { "$ref": "#/$defs/run_request" },
    { "$ref": "#/$defs/run_response_succeeded" },
    { "$ref": "#/$defs/run_response_failed" },
    { "$ref": "#/$defs/run_response_error" },
    { "$ref": "#/$defs/run_response_rejected" }
  ],
  "$defs": {
    "run_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "contract_version", "stage", "run_id", "release", "changes", "selection"],
      "properties": {
        "document": { "const": "run_request" },
        "contract_version": { "$ref": "common.schema.json#/$defs/contract_version" },
        "stage": { "$ref": "common.schema.json#/$defs/stage" },
        "run_id": { "$ref": "common.schema.json#/$defs/id" },
        "release": { "$ref": "common.schema.json#/$defs/release" },
        "changes": { "$ref": "common.schema.json#/$defs/change_set" },
        "selection": { "$ref": "common.schema.json#/$defs/selection" }
      }
    },
    "run_response_succeeded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document", "contract_version", "stage", "run_id", "outcome", "release", "changes",
        "selection", "time_basis", "quantities", "model_points", "export"
      ],
      "properties": {
        "document": { "const": "run_response" },
        "contract_version": { "$ref": "common.schema.json#/$defs/contract_version" },
        "stage": { "$ref": "common.schema.json#/$defs/stage" },
        "run_id": { "$ref": "common.schema.json#/$defs/id" },
        "outcome": { "const": "succeeded" },
        "release": { "$ref": "common.schema.json#/$defs/release" },
        "changes": { "$ref": "common.schema.json#/$defs/change_set" },
        "selection": { "$ref": "common.schema.json#/$defs/selection" },
        "time_basis": { "$ref": "common.schema.json#/$defs/time_basis" },
        "quantities": { "$ref": "common.schema.json#/$defs/quantities" },
        "model_points": {
          "description": "Every exported model point with its period range.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/period_range" }
        },
        "export": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact", "data_rows"],
          "properties": {
            "artifact": { "$ref": "common.schema.json#/$defs/artifact" },
            "data_rows": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "run_response_failed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document", "contract_version", "stage", "run_id", "outcome", "release", "changes",
        "selection", "failed_model_points"
      ],
      "properties": {
        "document": { "const": "run_response" },
        "contract_version": { "$ref": "common.schema.json#/$defs/contract_version" },
        "stage": { "$ref": "common.schema.json#/$defs/stage" },
        "run_id": { "$ref": "common.schema.json#/$defs/id" },
        "outcome": { "const": "failed" },
        "release": { "$ref": "common.schema.json#/$defs/release" },
        "changes": { "$ref": "common.schema.json#/$defs/change_set" },
        "selection": { "$ref": "common.schema.json#/$defs/selection" },
        "failed_model_points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["model_point_id", "message"],
            "properties": {
              "model_point_id": { "$ref": "common.schema.json#/$defs/id" },
              "message": { "$ref": "common.schema.json#/$defs/text" }
            }
          }
        }
      }
    },
    "run_response_error": {
      "description": "The engine accepted the request and could not restore or read the state it names.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document", "contract_version", "stage", "run_id", "outcome", "release", "changes",
        "selection", "diagnostics"
      ],
      "properties": {
        "document": { "const": "run_response" },
        "contract_version": { "$ref": "common.schema.json#/$defs/contract_version" },
        "stage": { "$ref": "common.schema.json#/$defs/stage" },
        "run_id": { "$ref": "common.schema.json#/$defs/id" },
        "outcome": { "const": "error" },
        "release": { "$ref": "common.schema.json#/$defs/release" },
        "changes": { "$ref": "common.schema.json#/$defs/change_set" },
        "selection": { "$ref": "common.schema.json#/$defs/selection" },
        "diagnostics": { "$ref": "common.schema.json#/$defs/diagnostics" }
      }
    },
    "run_response_rejected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "contract_version", "outcome", "diagnostics"],
      "properties": {
        "document": { "const": "run_response" },
        "contract_version": { "$ref": "common.schema.json#/$defs/contract_version" },
        "stage": { "$ref": "common.schema.json#/$defs/stage" },
        "run_id": { "$ref": "common.schema.json#/$defs/id" },
        "outcome": { "const": "rejected" },
        "diagnostics": { "$ref": "common.schema.json#/$defs/diagnostics" }
      }
    }
  }
}
