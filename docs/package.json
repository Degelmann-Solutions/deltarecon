{
  "name": "deltarecon-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build && pagefind --site dist",
    "local": "npm run build && astro preview",
    "check": "npm run build && node scripts/check-site.mjs && node scripts/check-head.mjs && node scripts/check-a11y.mjs && node scripts/check-glossary.mjs && node scripts/check-steps.mjs",
    "check:apache": "npm run build && node scripts/check-apache.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "4.3.14",
    "@tailwindcss/vite": "4.3.2",
    "astro": "5.18.2",
    "pagefind": "1.6.0",
    "tailwindcss": "4.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@axe-core/playwright": "4.13.0",
    "playwright": "1.61.1",
    "typescript": "5.9.3"
  }
}
