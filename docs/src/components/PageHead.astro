---
// The head of a page: the stage line, the title, the lead. The stage line
// names the stage of the page; on the page below the four stages it names
// the page kind. It is not part of the searched text of the page
// (`data-pagefind-ignore`); the search takes it from the register.
// A page outside the path has no stage line. The head is marked
// `data-page-head`: the glossary check counts the content after it only,
// since the lead is plain text and cannot hold a glossary link.
import { onPath, stageLine, type Lang, type Page } from '../site';

interface Props {
  lang: Lang;
  page: Page;
  lead: string;
}

const { lang, page, lead } = Astro.props;
---

<div data-page-head>
  {
    onPath(page) && (
      <p class="mb-2.5 text-caption text-text-secondary" data-stage-line data-pagefind-ignore>
        {stageLine(page, lang)}
      </p>
    )
  }
  <h1 class="max-w-text-max text-page-title-phone text-balance tablet:text-page-title">
    {page.name[lang]}
  </h1>
  <p class="mt-3.5 max-w-text-max text-lead-phone text-text-secondary tablet:text-lead">{lead}</p>
</div>
