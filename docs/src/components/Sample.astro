---
// A sample: what a member of the protocol takes or gives at the reference
// model, as lines under a small label (src/adapterSamples.ts). It is an
// illustration: no copy button. The block scrolls sideways inside its box,
// takes keyboard focus for that and is a region named by its label. The
// search index leaves a sample out: its values are words of the program,
// German in both languages, and the search would offer the page for them.
//
//   <Sample id="describe" label="Call and result" />
import { samples } from '../adapterSamples';

interface Props {
  /** The key of the sample in src/adapterSamples.ts. */
  id: string;
  /** What the lines are, in the language of the page. */
  label: string;
}

const { id, label } = Astro.props;
const lines = samples[id];
if (!lines) {
  throw new Error(`${Astro.url.pathname}: no sample "${id}" in src/adapterSamples.ts.`);
}
if (typeof label !== 'string' || label.trim() === '') {
  throw new Error(`${Astro.url.pathname}: the sample "${id}" has no "label".`);
}
---

<div class="sample" data-sample={id} data-pagefind-ignore>
  <p class="list-label" data-no-term>{label}</p>
  <pre class="code" tabindex="0" role="region" aria-label={`${label} (${id})`} translate="no"><code>{lines.join('\n')}</code></pre>
</div>
