---
// The footer: one row of four links to imprint, privacy, licence and
// repository. Imprint and privacy are pages of the company website, which is
// German. Licence and repository are on GitHub, another site: they open in
// a new tab (OutsideLink.astro).
import OutsideLink from './OutsideLink.astro';
import { outside, texts, type Lang } from '../site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = texts[lang];
const links = [
  { name: t.imprint, href: outside.imprint, hreflang: 'de' },
  { name: t.privacy, href: outside.privacy, hreflang: 'de' },
  { name: t.licence, href: outside.licence, hreflang: 'en', newTab: true },
  { name: t.repository, href: outside.repository, hreflang: 'en', newTab: true },
];
const look = 'inline-link inline-flex min-h-6 items-center';
---

<footer
  class="flex flex-wrap gap-x-5 gap-y-2 border-t border-border bg-bg px-3 py-3.5 text-caption text-text-secondary tablet:px-5 menu-open:hidden"
  data-behind-menu
>
  {
    links.map((link) =>
      link.newTab ? (
        <OutsideLink class={look} href={link.href} hreflang={link.hreflang}>{link.name}</OutsideLink>
      ) : (
        <a class={look} href={link.href} hreflang={link.hreflang}>
          {link.name}
        </a>
      ),
    )
  }
</footer>
