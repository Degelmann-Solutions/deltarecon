---
// Placeholder layout of the tracer. The page frame of the documentation
// replaces it.
import '../styles/global.css';
import Search from '../components/Search.astro';
import { version } from '../release';

interface Props {
  frontmatter: { title: string; lang: 'de' | 'en' };
}

const { title, lang } = Astro.props.frontmatter;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const counterpart =
  lang === 'de'
    ? { lang: 'en', name: 'English' }
    : { lang: 'de', name: 'Deutsch' };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="mx-auto max-w-2xl p-6">
    <header class="mb-6 flex flex-wrap items-baseline gap-4">
      <span data-release translate="no">DeltaRecon {version}</span>
      <a
        class="underline"
        data-counterpart
        href={`${base}${counterpart.lang}/`}
        hreflang={counterpart.lang}
        lang={counterpart.lang}>{counterpart.name}</a
      >
      <Search lang={lang} />
    </header>
    <main data-pagefind-body>
      <h1 class="mb-4 text-2xl font-semibold">{title}</h1>
      <slot />
    </main>
  </body>
</html>
